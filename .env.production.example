# Copy to .env on the server. .env is ignored by git.
# Use a long alphanumeric POSTGRES_PASSWORD, or URL-encode reserved characters
# when building DATABASE_URL (for example @ becomes %40).

APP_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/calorie-tracker:latest
# Public hostname for Caddy. Use ":80" only for HTTP-only testing.
APP_DOMAIN=calorie.example.com

POSTGRES_DB=calorie
POSTGRES_USER=calorie
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://calorie:replace-with-a-long-random-password@db:5432/calorie

ADMIN_CONFIRM_PASSWORD=replace-with-a-separate-admin-password
ALLOW_REGISTRATION=true
SEED_FOODS_IF_EMPTY=true
COOKIE_SECURE=true
CORS_ORIGINS=https://calorie.example.com

# Optional photo meal analysis
DEEPSEEK_API_KEY=
PHOTO_LLM_BASE_URL=https://api.deepseek.com
PHOTO_LLM_MODEL=deepseek-flash
PHOTO_LLM_REASONING_EFFORT=none
PHOTO_LLM_TIMEOUT_SECONDS=60
PHOTO_MAX_IMAGE_BYTES=8388608
