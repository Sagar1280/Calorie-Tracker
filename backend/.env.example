# Copy this file to .env and fill in local secrets.
# .env is ignored by git. Never commit real keys.

DEEPSEEK_API_KEY=
PHOTO_LLM_BASE_URL=https://api.deepseek.com
PHOTO_LLM_MODEL=deepseek-flash
PHOTO_LLM_REASONING_EFFORT=none
PHOTO_LLM_TIMEOUT_SECONDS=60

# Required to confirm food database changes in the admin review screen.
ADMIN_CONFIRM_PASSWORD=

# Machine-specific settings
# Leave DATABASE_URL empty to use SQLite at CALORIE_DB_PATH.
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/calorie
# CALORIE_DB_PATH=C:\path\to\calorie_tracker.db
# CALORIE_UPLOAD_DIR=C:\path\to\uploads
# COOKIE_SECURE=false
# ALLOW_REGISTRATION=true
# SEED_FOODS_IF_EMPTY=false
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
